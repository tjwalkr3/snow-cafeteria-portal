@rendermode InteractiveServer

<div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Food Options to Type</h5>
                <button type="button" class="btn-close" @onclick="Cancel" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="searchInput" class="form-label fw-medium">Search Food Options</label>
                    <input type="text" id="searchInput" class="form-control" placeholder="Search options..." 
                        @bind="SearchText" @bind:event="oninput" />
                </div>

                @if (AssignedOptions.Any())
                {
                    <div class="mb-4">
                        <h6 class="fw-semibold mb-2">Already Assigned Options</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var option in AssignedOptions)
                            {
                                <div class="badge bg-success d-flex align-items-center gap-2 p-2">
                                    <span>@option.FoodOptionName</span>
                                    <button type="button" class="btn btn-sm p-0" style="background: none; border: none; color: white;"
                                        @onclick="() => RemoveOption(option.Id)" title="Remove option">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <h6 class="fw-semibold mb-2">Available Options</h6>
                    @if (FilteredAvailableOptions.Any())
                    {
                        <div class="list-group" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var option in FilteredAvailableOptions)
                            {
                                <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                    @onclick="() => HandleAdd(option.Id)">
                                    <div class="d-flex align-items-center gap-2">
                                        <span>@option.FoodOptionName</span>
                                        @if (!option.InStock)
                                        {
                                            <span class="badge bg-warning text-dark">Out of Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">In Stock</span>
                                        }
                                    </div>
                                    <i class="bi bi-plus-circle text-primary"></i>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            @if (SearchText.Any() && !AvailableOptions.Any())
                            {
                                <p>No options match your search.</p>
                            }
                            else
                            {
                                <p>All available options have been assigned.</p>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger mb-0">@ErrorMessage</div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Cancel">Close</button>
            </div>
        </div>
    </div>
</div>